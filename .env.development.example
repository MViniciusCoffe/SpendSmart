# Docker Compose Local Postgres (npm run services:up)
# Use apenas se NÃO estiver usando Supabase CLI

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=local_user
POSTGRES_DB=local_db
POSTGRES_PASSWORD=local

# IMPORTANTE: expansão manual necessária (dotenv não expande $VAR em connection string)
DATABASE_URL=postgres://local_user:local@localhost:5432/local_db

# Para Supabase remoto (produção/homologação) — NÃO use com npm run dev
# NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sua-chave-publica
# SUPABASE_SERVICE_ROLE_KEY=sua-chave-de-servico