# Supabase CLI Local (supabase start)
# Use com: npm run next:dev  (após supabase start)
# Renomeie para .env.local e preencha com o output de 'supabase status'

# URL da API REST local (Kong gateway) — fixa
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Chave pública (anon) — pegue no output de 'supabase status'
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chave de serviço (service_role) — SOMENTE server-side (pages/api/*)
# NUNCA coloque prefixo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: para testes de integração contra banco local real
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres