# Supabase CLI local (supabase start) — o único ambiente de desenvolvimento
# Copie para .env.local e preencha com o output de 'npm run infra:status'
# O scripts/dev.js recusa iniciar se a URL abaixo não for local (127.0.0.1/localhost)

# URL da API REST local (Kong gateway) — fixa
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Chave pública (publishable) — pegue no output de 'supabase status'
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chave de serviço (secret) — SOMENTE server-side (src/app/api/*)
# NUNCA coloque prefixo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: para testes de integração contra banco local real
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
