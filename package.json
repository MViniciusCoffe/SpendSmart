{
  "name": "spendsmart",
  "version": "0.1.0",
  "description": "Aplicacao web pessoal de controle financeiro: receitas, despesas, categorias e dashboard.",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.js",
    "next:dev": "next dev",
    "infra:up": "supabase start",
    "infra:down": "supabase stop",
    "infra:reset": "supabase db reset",
    "infra:studio": "supabase studio",
    "infra:status": "supabase status",
    "services:up": "docker compose -f infra/compose.yaml up -d",
    "services:stop": "docker compose -f infra/compose.yaml stop",
    "services:down": "docker compose -f infra/compose.yaml down",
    "services:wait:database": "node scripts/wait-for-postgres.js",
    "migrations:create": "node-pg-migrate -m supabase/migrations --envPath .env.development create",
    "migrations:up": "node-pg-migrate -m supabase/migrations --envPath .env.development up",
    "migrations:down": "node-pg-migrate -m supabase/migrations --envPath .env.development down",
    "migrations:supabase:up": "node-pg-migrate -m supabase/migrations --envPath .env.supabase up",
    "test": "jest tests/unit",
    "test:watch": "jest tests/unit --watch",
    "test:coverage": "jest --coverage tests/unit",
    "test:integration": "jest tests/integration/postgres --runInBand",
    "test:integration:supabase": "jest tests/integration/supabase --runInBand",
    "test:integration:watch": "jest tests/integration/postgres --runInBand --watch",
    "test:integration:local": "jest tests/integration/postgres --runInBand",
    "test:all": "jest tests/unit tests/integration/postgres tests/regression tests/integration/supabase --runInBand",
    "check:agents": "node scripts/check-agents.js",
    "lint:prettier:check": "prettier --check .",
    "lint:prettier:write": "prettier --write .",
    "lint:eslint:check": "eslint .",
    "lint:eslint:fix": "eslint . --fix",
    "prepare": "husky",
    "commit": "cz"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "author": "MViniciusCoffe",
  "engines": {
    "node": ">=24.11.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.1",
    "chart.js": "^4.5.1",
    "dotenv": "^16.4.7",
    "next": "^16.3.5",
    "node-pg-migrate": "^8.0.3",
    "pg": "^8.16.3",
    "react": "^19.3.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@babel/preset-env": "^8.0.6",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "babel-jest": "^30.5.2",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.5.1",
    "pg-mem": "^3.0.14",
    "prettier": "^3.9.9"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
