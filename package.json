{
  "name": "spendsmart",
  "version": "0.2.0",
  "description": "Aplicacao web pessoal de controle financeiro: receitas, despesas, categorias e dashboard.",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.js",
    "next:dev": "next dev",
    "build": "next build",
    "start": "next start",
    "infra:up": "supabase start",
    "infra:down": "supabase stop",
    "infra:reset": "supabase db reset",
    "infra:studio": "supabase studio",
    "infra:status": "supabase status",
    "services:up": "docker compose -f infra/compose.yaml up -d --wait",
    "services:stop": "docker compose -f infra/compose.yaml stop",
    "services:down": "docker compose -f infra/compose.yaml down",
    "migrations:new": "supabase migration new",
    "migrations:up": "supabase migration up --local",
    "migrations:list": "node scripts/db-migrations.js list",
    "migrations:push": "node scripts/db-migrations.js push",
    "test": "jest tests/unit",
    "test:watch": "jest tests/unit --watch",
    "test:coverage": "jest --coverage tests/unit",
    "test:integration": "jest tests/integration/postgres --runInBand",
    "test:integration:supabase": "jest tests/integration/supabase --runInBand",
    "test:integration:watch": "jest tests/integration/postgres --runInBand --watch",
    "test:integration:local": "jest tests/integration/postgres --runInBand",
    "test:all": "jest tests/unit tests/integration/postgres tests/regression tests/integration/supabase --runInBand",
    "test:regression": "jest tests/regression",
    "test:mutation": "stryker run",
    "check:agents": "node scripts/check-agents.js",
    "lint:prettier:check": "prettier --check .",
    "lint:prettier:write": "prettier --write .",
    "lint:eslint:check": "eslint .",
    "lint:eslint:fix": "eslint . --fix",
    "prepare": "husky",
    "commit": "cz"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "author": "MViniciusCoffe",
  "engines": {
    "node": ">=24.11.0"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@supabase/supabase-js": "^2.118.0",
    "chart.js": "^4.6.1",
    "dotenv": "^16.4.7",
    "next": "^16.4.5",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@babel/eslint-parser": "^8.0.7",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.3",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/jest-runner": "^10.1.1",
    "babel-jest": "^30.5.2",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.0",
    "pg-mem": "^3.0.14",
    "prettier": "^3.9.10"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
